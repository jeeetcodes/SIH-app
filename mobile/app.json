{
  "expo": {
    "name": "LabelPolis",
    "slug": "label-polis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "labelpolis",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.labelpolis.app",
      "usesCleartextTraffic": true
    },

    "web": {
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "LabelPolis needs access to your photos to inspect packaging labels.",
          "cameraPermission": "LabelPolis needs camera access to scan packaging labels."
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    }
  }
}