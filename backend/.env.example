PROJECT_NAME=Label Police Backend
API_V1_STR=/api/v1

# ──────────────────────────────────────────────────────────────────────────────
# Vision Provider Configuration (Multi-Provider Fallback Cascade)
# ──────────────────────────────────────────────────────────────────────────────

# Layer 1: Google Gemini (native google-genai SDK)
# Comma-separated list of Gemini API keys for cascading fallback.
# The service will try each key across multiple models (gemini-3.6-flash, gemini-2.5-flash).
GEMINI_API_KEYS=

# Legacy single-key fallback (deprecated; use GEMINI_API_KEYS for multi-key support).
GEMINI_API_KEY=

# Layer 2: OpenRouter (free tier fallback when all Gemini keys are exhausted)
# OpenRouter provides free access to vision-capable models as backup nodes.
OPENROUTER_API_KEY=

# OpenRouter models tried in cascade: google/gemma-4-31b-it:free, meta-llama/llama-3.2-11b-vision-instruct:free, openrouter/free
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional public URL for OpenRouter request attribution.
OPENROUTER_SITE_URL=

# Layer 3: OpenAI (paid tier, not part of default cascade)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────────────────────────────────────
# Model Configuration
# ──────────────────────────────────────────────────────────────────────────────

GEMINI_MODEL=gemini-3.6-flash

# ──────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ──────────────────────────────────────────────────────────────────────────────

CORS_ORIGINS=["*"]
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./label_police.db
