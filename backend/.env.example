PROJECT_NAME=Label Police Backend
API_V1_STR=/api/v1
CORS_ORIGINS=["*"]
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./label_police.db
MAX_UPLOAD_BYTES=10485760
VISION_REQUEST_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# PRIMARY_VISION_AI — Gemini 1.5 / 2.0 Pro or Flash
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# FALLBACK_VISION_AI — GPT-4o, then Claude 3.5 Sonnet
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional extra vision gateway (kept for backward compatibility).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_SITE_URL=

# Comma-separated fallback order. Unconfigured providers are skipped.
VISION_PROVIDER_ORDER=gemini,openai,anthropic,openrouter,ocrspace,azure,google

# ---------------------------------------------------------------------------
# DEDICATED_OCR — OCR.space, Azure Computer Vision, or Google Cloud Vision
# ---------------------------------------------------------------------------
# OCR.space API: https://ocr.space/ocrapi (FREE - 25,000/month, no credit card)
OCRSPACE_API_KEY=

AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com
GOOGLE_CLOUD_VISION_KEY=

# ---------------------------------------------------------------------------
# PRODUCT_DATABASE_API — barcode catalogs / Open Food Facts
# ---------------------------------------------------------------------------
BARCODE_LOOKUP_API_KEY=
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org

# ---------------------------------------------------------------------------
# WEB_VERIFICATION_API — manufacturer / FSSAI lookup
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
SERPAPI_KEY=
